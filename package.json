{
  "name": "predent-canada",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/prerender.mjs && node tools/check-bundle-budget.mjs && esbuild server/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\" && mkdir -p dist/api && esbuild server/app.ts --platform=node --bundle --format=esm --outfile=dist/api/index.js --packages=external",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.config.ts",
    "test:frontend": "vitest run --config vitest.config.frontend.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts && vitest run --coverage --config vitest.config.frontend.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "licenses:check": "node tools/check-licenses.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify-plans": "tsx tools/verify-query-plans.ts",
    "db:capacity": "tsx tools/check-db-capacity.ts",
    "test:load": "node tools/load-test.mjs",
    "db:push": "drizzle-kit push",
    "db:seed:dat": "tsx db/seed-dat.ts",
    "db:seed:dat:full": "tsx db/seed-dat-full.ts",
    "db:seed:interview": "tsx db/seed-interview.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.20",
