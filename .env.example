# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Used to sign session JWTs
SESSION_KEY_ID=current    # JWT kid for APP_SECRET
SESSION_PREVIOUS_SECRETS={} # JSON map of old kid -> secret during rotation

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # Supabase PostgreSQL connection string
                          # e.g. postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
TEST_DATABASE_URL=        # Explicit disposable PostgreSQL database for integration tests
DATABASE_POOL_MAX=        # Defaults to 3 on Vercel and 10 elsewhere

# ── Distributed rate limiting (required in production) ─────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Retained for explicit local-only operation; the runtime falls back to the
# local in-process store automatically when Redis is unavailable.
RATE_LIMIT_ALLOW_IN_MEMORY=false
# Set only when a trusted reverse proxy sanitizes X-Forwarded-For.
TRUST_PROXY=false
# Set only when Cloudflare directly proxies traffic to the origin.
TRUST_CLOUDFLARE_PROXY=false
PUSH_ENDPOINT_ALLOWED_HOSTS= # Optional comma-separated Web Push provider allowlist

# ── Payments (Stripe) ──────────────────────────────────────────
STRIPE_SECRET_KEY=        # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=    # whsec_... for webhook signature verification
STRIPE_PRICE_PREMIUM_MONTHLY=     # price_... for $29/mo Premium plan
STRIPE_PRICE_PREMIUM_YEARLY=      # price_... for $249/yr Premium plan
STRIPE_PRICE_PLUS_LIFETIME=      # price_... for $149 one-time Plus plan

# ── Google OAuth ────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=    # Browser-facing Google OAuth client ID
GOOGLE_CLIENT_ID=         # Same Google OAuth client ID (backend)
GOOGLE_CLIENT_SECRET=     # Google OAuth client secret

# ── X (Twitter) OAuth 2.0 ───────────────────────────────────────
X_CLIENT_ID=              # X/Twitter OAuth 2.0 client ID
X_CLIENT_SECRET=          # X/Twitter OAuth 2.0 client secret

# ── Instagram OAuth ─────────────────────────────────────────────
INSTAGRAM_CLIENT_ID=      # Instagram app client ID
INSTAGRAM_CLIENT_SECRET=  # Instagram app client secret

# ── LinkedIn OAuth 2.0 ──────────────────────────────────────────
LINKEDIN_CLIENT_ID=       # LinkedIn app client ID
LINKEDIN_CLIENT_SECRET=   # LinkedIn app client secret

# ── Apple Sign In ───────────────────────────────────────────────
APPLE_CLIENT_ID=          # Apple Services ID (e.g. com.example.predent)
APPLE_TEAM_ID=            # Apple Team ID (10 characters)
APPLE_KEY_ID=             # Apple private key ID
APPLE_PRIVATE_KEY=        # PEM-encoded Apple private key (can include newlines)

# ── Discord OAuth 2.0 ───────────────────────────────────────────
DISCORD_CLIENT_ID=        # Discord app client ID
DISCORD_CLIENT_SECRET=    # Discord app client secret

# ── Microsoft Entra ID ──────────────────────────────────────────
MICROSOFT_TENANT=common   # Entra tenant ID or "common" for personal accounts
MICROSOFT_CLIENT_ID=      # Microsoft app client ID
MICROSOFT_CLIENT_SECRET=  # Microsoft app client secret

# ── Facebook OAuth ──────────────────────────────────────────────
FACEBOOK_CLIENT_ID=       # Facebook app ID
FACEBOOK_CLIENT_SECRET=   # Facebook app secret

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Google "sub" of the app creator; this user gets role "admin" on first login

# ── Email / Notifications ───────────────────────────────────────
EMAIL_PROVIDER=           # "console" (default) or "resend"
EMAIL_FROM=               # Sender address (e.g. noreply@predent.vercel.app)
RESEND_API_KEY=           # re_... (required when EMAIL_PROVIDER=resend)
PUBLIC_APP_URL=           # Public origin for links (e.g. https://predent.vercel.app)

# ── Vercel Cron (optional) ──────────────────────────────────────
CRON_SECRET=              # Random secret used to authenticate Vercel cron requests

# ── Monitoring ──────────────────────────────────────────────────
METRICS_SECRET=           # Bearer token protecting /api/metrics
